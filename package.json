{
  "name": "fileforge",
  "version": "5.0.0",
  "description": "Open-source, privacy-first document toolkit with 20+ tools. PDF, DOCX, images — all processed 100% in your browser. Dark mode, bilingual, zero uploads.",
  "private": false,
  "license": "MIT",
  "homepage": "https://pdfcontrol.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/concrete-sangminlee/pdfremover.git"
  },
  "keywords": [
    "pdf",
    "pdf-tools",
    "pdf-editor",
    "pdf-merge",
    "pdf-split",
    "pdf-unlock",
    "pdf-compress",
    "image-converter",
    "image-compress",
    "image-resize",
    "docx-viewer",
    "document-toolkit",
    "browser-based",
    "privacy-first",
    "dark-mode",
    "nextjs",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "verify:static": "node scripts/verify-static-pages.mjs",
    "verify": "npm run typecheck && npm test && npm audit --audit-level=moderate && npm run build && npm run verify:static",
    "start": "next start"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "^16.2.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.6.205",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10",
    "postcss": "8.5.15",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
